---
// The socle wordmark: the word, lowercase and as wide as Archivo goes,
// standing on a two-step plinth whose lower step overhangs the upper one.
interface Props {
  size?: 'nav' | 'hero';
}
const { size = 'nav' } = Astro.props;
---

<span class:list={['wordmark', size]} aria-label="socle" role="img">
  <span class="word" aria-hidden="true">socle</span>
  <span class="step1" aria-hidden="true"></span>
  <span class="step2" aria-hidden="true"></span>
</span>

<style>
  .wordmark {
    display: inline-flex;
    flex-direction: column;
    align-items: stretch;
    color: inherit;
  }
  .word {
    font-family: var(--font-display);
    font-weight: 850;
    font-stretch: 125%;
    letter-spacing: -0.03em;
    line-height: 1;
    padding-inline: 0.12em;
  }
  .step1,
  .step2 {
    background: currentColor;
  }
  .nav .word {
    font-size: 1.45rem;
  }
  .nav .step1 {
    height: 0.2rem;
    margin-top: 0.16rem;
  }
  .nav .step2 {
    height: 0.13rem;
    margin-top: 0.11rem;
    margin-inline: -0.22rem;
  }
  .hero .word {
    font-size: clamp(3.5rem, 14vw, 8.5rem);
  }
  .hero .step1 {
    height: clamp(0.6rem, 1.3vw, 0.95rem);
    margin-top: clamp(0.4rem, 0.9vw, 0.7rem);
  }
  .hero .step2 {
    height: clamp(0.4rem, 0.8vw, 0.6rem);
    margin-top: clamp(0.3rem, 0.65vw, 0.5rem);
    margin-inline: clamp(-1.6rem, -3vw, -0.8rem);
  }
</style>
