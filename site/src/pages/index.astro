---
// The landing page. Not a Starlight page: it has its own layout, the
// identity's one bold moment (the wordmark on its plinth), and links into
// the documentation, which Starlight renders.
import '../styles/tokens.css';
import Wordmark from '../components/Wordmark.astro';
import { bannerHtml } from '../channel';
import { modules } from '../catalog.mjs';
import argo from '../logos/argo.svg?raw';
import aws from '../logos/aws.svg?raw';
import azure from '../logos/azure.svg?raw';
import crossplane from '../logos/crossplane.svg?raw';
import gcp from '../logos/gcp.svg?raw';
import grafana from '../logos/grafana.svg?raw';
import keda from '../logos/keda.svg?raw';
import kubernetes from '../logos/kubernetes.svg?raw';
import kyverno from '../logos/kyverno.svg?raw';
import opentelemetry from '../logos/opentelemetry.svg?raw';
import scaleway from '../logos/scaleway.svg?raw';
import victoriametrics from '../logos/victoriametrics.svg?raw';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const to = (path: string) => `${base}/${path}`;
const repository = 'https://github.com/do-now-io/socle';
// The last release, as every other stamp in the repository: release-please
// rewrites this line in its release PR, check-version.sh holds it to VERSION.
const socleVersion = '0.1.0'; // x-release-please-version
const banner = bannerHtml();
const onByDefault = modules.filter((m) => m.enabled).length;

const clouds = [
  { id: 'aws', cloud: 'AWS', service: 'EKS', note: 'One-apply root ready' },
  { id: 'gcp', cloud: 'GCP', service: 'GKE', note: 'Foundations ready' },
  { id: 'azure', cloud: 'Azure', service: 'AKS', note: 'Foundations ready' },
  { id: 'scaleway', cloud: 'Scaleway', service: 'Kapsule', note: 'Foundations ready' },
];

const reasons = [
  ['One apply', 'A single OpenTofu root creates the cluster, installs Flux and hands the catalog over. Then OpenTofu steps away.'],
  ['One version', '`socle_version` pins the OpenTofu modules and the Flux artifact together. An upgrade is one line in your tfvars.'],
  ['Signed end to end', 'Both artifacts are signed keyless with cosign, and Flux checks the signature on every reconciliation.'],
  ['Mistakes fail at plan', 'A misspelt module or attribute is rejected by `tofu plan`, with the allowed values listed.'],
  ['No out-of-band scripts', 'A module that needs cloud access declares its own IAM through Crossplane. The foundations never change.'],
  ['Your values win', 'Every module takes any chart value in `values`. Secrets go in `values_secret`, never in the state.'],
];
// The README's example, trimmed. HCL braces would be Astro expressions in
// the template, so it is a string.
const tfvars = `<span class="c"># clusters/prod.tfvars</span>
socle_version = <span class="s">"${socleVersion}"</span>   <span class="c"># the only line an upgrade touches</span>

aws = {
  region             = <span class="s">"eu-west-3"</span>
  cluster_name       = <span class="s">"acme-prod"</span>
  kubernetes_version = <span class="s">"1.34"</span>
}

kube = {
  argocd          = { domain = <span class="s">"argocd.acme.example"</span> }
  victoria_traces = { enabled = <span class="k">true</span> }
}`;
// The plinth: what the catalog installs stands on the socle, and the socle
// stands on the four clouds. Modules without a logo of their own are left
// out here; the catalog section below lists every one.
const standing = [
  { svg: argo, name: 'Argo CD', page: 'catalog/argocd/' },
  { svg: kubernetes, name: 'Gateway API', page: 'catalog/gateway-api/' },
  { svg: crossplane, name: 'Crossplane', page: 'catalog/crossplane/' },
  { svg: kyverno, name: 'Kyverno', page: 'catalog/kyverno/' },
  { svg: keda, name: 'KEDA', page: 'catalog/keda/' },
  { svg: opentelemetry, name: 'OpenTelemetry', page: 'catalog/otel-gateway/' },
  { svg: victoriametrics, name: 'VictoriaMetrics', page: 'catalog/victoria-metrics/' },
  { svg: grafana, name: 'Grafana', page: 'catalog/grafana/' },
];
const foundations = [
  { svg: aws, name: 'AWS', page: 'clouds/aws/' },
  { svg: gcp, name: 'Google Cloud', page: 'clouds/gcp/' },
  { svg: azure, name: 'Azure', page: 'clouds/azure/' },
  { svg: scaleway, name: 'Scaleway', page: 'clouds/scaleway/' },
];
// The catalog as bricks: one per module, its mark, category and one line.
// Modules with no logo of their own get a monogram.
const marks: Record<string, string> = {
  argocd: argo,
  'gateway-api': kubernetes,
  crossplane,
  kyverno,
  'kyverno-policies': kyverno,
  keda,
  'otel-agent': opentelemetry,
  'otel-gateway': opentelemetry,
  'victoria-metrics': victoriametrics,
  'victoria-logs': victoriametrics,
  'victoria-traces': victoriametrics,
  grafana,
};
const monogram: Record<string, string> = { 'external-dns': 'DNS', 'external-secrets': 'ES', reloader: 'R', velero: 'V', hello: 'H' };
const categories = ['gitops', 'networking', 'security', 'secrets', 'autoscaling', 'observability', 'backup', 'platform'];
const bricks = [...modules].sort(
  (a, b) => categories.indexOf(a.category) - categories.indexOf(b.category) || a.page.localeCompare(b.page),
);
const where = (clouds: string[] | null) =>
  clouds === null ? 'Every cloud' : clouds.length === 1 ? `${clouds[0]} only` : clouds.join(', ');
const inline = (text: string) => text.replace(/`([^`]+)`/g, '<code>$1</code>');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>socle: GitOps for managed Kubernetes</title>
    <meta
      name="description"
      content="An open source GitOps distribution for managed Kubernetes clusters, on EKS, GKE, AKS and Scaleway Kapsule."
    />
    <link rel="icon" href={to('favicon.svg')} type="image/svg+xml" />
    <script is:inline>
      // The theme the documentation pages use (Starlight's own key), so the
      // landing page never flashes the other one.
      try {
        const stored = localStorage.getItem('starlight-theme');
        const theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : matchMedia('(prefers-color-scheme: light)').matches
              ? 'light'
              : 'dark';
        document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body>
    {banner && <p class="banner" set:html={banner} />}

    <header class="hero">
      <nav class="top" aria-label="Site">
        <a class="home" href={to('')}><Wordmark /></a>
        <span class="links">
          <a href={to('getting-started/concepts/')}>Docs</a>
          <a href={to('catalog/')}>Catalog</a>
          <a href={repository}>GitHub</a>
        </span>
      </nav>

      <div class="stage">
        <h1 class="mark"><Wordmark size="hero" /></h1>
        <p class="baseline">The GitOps distribution for managed Kubernetes.</p>
        <p class="lede">
          Pick your cloud, pick your modules. Flux pulls one signed artifact, and upgrading the whole platform is one
          line in Git.
        </p>
        <div class="ctas">
          <a class="btn primary" href={to('getting-started/concepts/')}>Read the docs</a>
          <a class="btn ghost" href={repository}>View on GitHub</a>
        </div>
      </div>
      <div class="base">
        <ul class="standing" aria-label="Modules in the catalog">
          {
            standing.map((m, i) => (
              <li style={`--i: ${i}`}>
                <a href={to(m.page)} title={m.name} aria-label={m.name}>
                  <span class="logo" aria-hidden="true" set:html={m.svg} />
                </a>
              </li>
            ))
          }
        </ul>
        <ul class="plinth" aria-label="Clouds it runs on">
          {
            foundations.map((c) => (
              <li>
                <a href={to(c.page)}>
                  <span class="logo" aria-hidden="true" set:html={c.svg} />
                  <span class="name">{c.name}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </header>

    <main>
      <section class="layers" aria-labelledby="layers-title">
        <div class="text">
          <h2 id="layers-title">Three layers, one version</h2>
          <p>
            OpenTofu lays the foundations once. Flux keeps the catalog in step with the signed artifact from then on. One
            version number moves all of it.
          </p>
          <a href={to('architecture/overview/')}>How it fits together</a>
        </div>
        <ol class="strata" reversed aria-label="The three layers, from the top">
          <li class="s3">
            <strong>Upgrades</strong>
            <span><code>socle_version</code> pins the modules and the artifact together</span>
          </li>
          <li class="s2">
            <strong>Catalog</strong>
            <span>À la carte modules, one Flux Operator ResourceSet each</span>
          </li>
          <li class="s1">
            <strong>Foundations</strong>
            <span>Network, cluster, identities and the bootstrap, in one apply</span>
          </li>
        </ol>
      </section>

      <section class="write" aria-labelledby="write-title">
        <div class="text">
          <h2 id="write-title">One file per cluster</h2>
          <p>Under <code>kube</code>, list only what differs from the catalog defaults.</p>
        </div>
        <pre class="code"><code set:html={tfvars} /></pre>
        <ul class="reasons">
          {
            reasons.map(([title, text]) => (
              <li>
                <strong>{title}</strong>
                <span set:html={inline(text)} />
              </li>
            ))
          }
        </ul>
      </section>

      <section class="clouds" aria-labelledby="clouds-title">
        <h2 id="clouds-title">Pick your cloud</h2>
        <ul>
          {
            clouds.map((c) => (
              <li>
                <a href={to(`clouds/${c.id}/`)}>
                  <span class="cloud">{c.cloud}</span>
                  <span class="service">{c.service}</span>
                  <span class="note">{c.note}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="catalog" aria-labelledby="catalog-title">
        <div class="text">
          <h2 id="catalog-title">The catalog</h2>
          <p>
            {modules.length} modules, {onByDefault} of them on by default. Each one is a line under <code>kube</code>: turn
            it on, give it your values, turn it off.
          </p>
        </div>
        <div class="filters" role="group" aria-label="Show one category" hidden>
          <button type="button" aria-pressed="true" data-category="">All</button>
          {
            categories
              .filter((c) => modules.some((m) => m.category === c))
              .map((c) => (
                <button type="button" aria-pressed="false" data-category={c}>
                  {c}
                </button>
              ))
          }
        </div>
        <ul class="bricks">
          {
            bricks.map((m) => (
              <li data-category={m.category}>
                <a href={to(`catalog/${m.page}/`)}>
                  <span class="brick-head">
                    {marks[m.page] ? (
                      <span class="mark-tile" aria-hidden="true" set:html={marks[m.page]} />
                    ) : (
                      <span class="mark-tile monogram" data-long={monogram[m.page].length > 2 ? '' : undefined} aria-hidden="true">
                        {monogram[m.page]}
                      </span>
                    )}
                    <span class="state" data-on={m.enabled ? '' : undefined}>
                      {m.enabled ? 'on by default' : 'off by default'}
                    </span>
                  </span>
                  <span class="brick-name">{m.page}</span>
                  <span class="brick-category">{m.category}</span>
                  <span class="brick-desc">{m.description}</span>
                  <span class="brick-clouds">{where(m.clouds)}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <a class="all" href={to('catalog/')}>The catalog in the documentation</a>
      </section>
    </main>

    <script>
      // The category filter. Without script every brick shows, and the
      // buttons stay hidden.
      const group = document.querySelector<HTMLElement>('.filters');
      const bricks = document.querySelectorAll<HTMLElement>('.bricks li');
      if (group) {
        group.hidden = false;
        group.addEventListener('click', (event) => {
          const button = (event.target as HTMLElement).closest('button');
          if (!button) return;
          const category = button.dataset.category ?? '';
          for (const b of group.querySelectorAll('button')) b.setAttribute('aria-pressed', String(b === button));
          for (const brick of bricks) brick.hidden = category !== '' && brick.dataset.category !== category;
        });
      }
    </script>

    <footer>
      <span>
        <a href={`${repository}/blob/main/LICENSE`}>Apache-2.0</a>
        <a href={`${repository}/blob/main/SECURITY.md`}>Security</a>
        <a href={to('contributing/')}>Contributing</a>
      </span>
      <span>by do-now</span>
    </footer>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html {
    color-scheme: light dark;
  }
  body {
    margin: 0;
    background: var(--stone);
    color: var(--basalt);
    font: 400 1.0625rem/1.6 var(--font-body);
    -webkit-font-smoothing: antialiased;
  }
  a {
    color: var(--accent);
    text-underline-offset: 3px;
  }
  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  code {
    font-family: var(--font-mono);
    font-size: 0.88em;
  }
  h2 {
    margin: 0;
    font: 800 clamp(1.75rem, 3.6vw, 2.5rem) / 1.1 var(--font-display);
    font-stretch: 115%;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>

<style>
  .banner {
    margin: 0;
    padding: 0.55rem 16px;
    text-align: center;
    font-size: 0.875rem;
    background: var(--stone-sunk);
    border-bottom: 2px solid var(--ochre);
  }

  /* ---- hero: always basalt, the wordmark standing on its plinth ---- */
  .hero {
    --ink: #f5fff7;
    --ink-muted: #a9c2b2;
    background: var(--pine);
    color: var(--ink);
    display: flex;
    flex-direction: column;
  }
  .top {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: 76rem;
    margin: 0 auto;
    padding: 1.25rem 16px;
  }
  .home {
    color: var(--ink);
  }
  .links {
    display: flex;
    gap: 1.75rem;
    font-weight: 600;
  }
  .links a {
    color: var(--ink);
    text-decoration: none;
  }
  .links a:hover {
    text-decoration: underline;
  }
  .stage {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.1rem;
    text-align: center;
    padding: 1.25rem 16px 2.5rem;
  }
  .mark {
    margin: 0 0 0.35rem;
    font-weight: normal;
    color: var(--ink);
  }
  .baseline {
    margin: 0;
    max-width: 22ch;
    font: 800 clamp(1.75rem, 4.4vw, 3.25rem) / 1.08 var(--font-display);
    font-stretch: 112%;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  /* Short screens (a laptop at 720 px): the hero tightens so the plinth,
     with what stands on it and what it stands on, is in the first view. */
  @media (max-height: 760px) and (min-width: 40rem) {
    .top {
      padding-block: 0.75rem;
    }
    .stage {
      gap: 0.8rem;
      padding-block: 0.25rem 1.75rem;
    }
    .mark :global(.word) {
      font-size: 6.25rem;
    }
    .baseline {
      font-size: 2.6rem;
    }
  }
  .lede {
    margin: 0;
    max-width: 46ch;
    color: var(--ink-muted);
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
    text-wrap: pretty;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.9rem;
    margin-top: 0.75rem;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    min-height: 3.5rem;
    padding: 0 2rem;
    border-radius: 3px;
    font: 700 1.125rem/1 var(--font-display);
    font-stretch: 112%;
    text-decoration: none;
  }
  .btn.primary {
    background: var(--lime);
    color: #062a19;
    padding-inline: 2.75rem;
  }
  .btn.primary:hover {
    background: var(--lime-hover);
  }
  .btn.ghost {
    color: var(--ink);
    box-shadow: inset 0 0 0 1.5px #4d6b59;
  }
  .btn.ghost:hover {
    box-shadow: inset 0 0 0 1.5px var(--ink);
  }
  .hero :focus-visible {
    outline-color: var(--lime);
  }
  /* The base of the hero, drawn as what it is: the catalog's modules stand
     on the socle, and the socle stands on the four clouds — the plinth, one
     step of the page's ground rising into the basalt. */
  .base {
    width: min(64rem, calc(100% - 32px));
    margin: 0 auto;
  }
  .standing,
  .plinth {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-evenly;
  }
  .standing {
    align-items: flex-end;
    gap: 0.75rem;
    padding-inline: 4%;
  }
  /* No bottom padding: each logo stands on the plinth's top edge. */
  .standing a {
    display: block;
    padding: 0.5rem 0.5rem 0.15rem;
    color: var(--ink);
  }
  .standing a:hover {
    color: var(--lime);
  }
  .standing .logo {
    display: block;
    width: clamp(2rem, 4.2vw, 3rem);
    height: clamp(2rem, 4.2vw, 3rem);
  }
  .plinth {
    gap: 0.5rem 1rem;
    padding: 1.1rem 1.5rem 1.25rem;
    background: var(--stone);
    border-radius: 3px 3px 0 0;
  }
  .plinth a {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.35rem 0.5rem;
    color: var(--basalt);
    text-decoration: none;
    font: 700 1rem/1 var(--font-display);
    font-stretch: 112%;
  }
  .plinth a:hover {
    color: var(--accent);
  }
  .plinth .logo {
    display: block;
    width: 1.9rem;
    height: 1.9rem;
  }
  /* Narrow screens: even grids, so no logo is left alone on its line. */
  @media (max-width: 40rem) {
    .standing {
      display: grid;
      grid-template-columns: repeat(4, auto);
      justify-content: space-evenly;
      padding-inline: 0;
    }
    .plinth {
      display: grid;
      grid-template-columns: repeat(2, auto);
      justify-content: space-evenly;
      padding-inline: 0.5rem;
    }
  }
  .logo :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* One moment, on load: the plinth rises with its clouds, then each module
     settles onto it, left to right. Nothing moves after that, and nothing
     moves at all for a reader who asked for less motion. */
  @media (prefers-reduced-motion: no-preference) {
    .plinth {
      animation: rise 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) 0.15s both;
    }
    .standing li {
      animation: settle 0.5s cubic-bezier(0.3, 1.4, 0.5, 1) calc(0.6s + var(--i) * 0.08s) both;
    }
  }
  @keyframes rise {
    from {
      transform: translateY(100%);
    }
  }
  @keyframes settle {
    from {
      opacity: 0;
      transform: translateY(-1.5rem);
    }
  }

  /* ---- sections ---- */
  main {
    max-width: 76rem;
    margin: 0 auto;
    padding: 0 16px;
  }
  section {
    display: grid;
    gap: 2rem 4rem;
    padding-block: clamp(3.5rem, 8vw, 6rem);
    border-bottom: 1px solid var(--hairline);
  }
  /* A grid item is as wide as its content by default; the code block would
     push the page wider than a phone. */
  section > * {
    min-width: 0;
  }
  .text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }
  .text p {
    margin: 0;
    max-width: 52ch;
    color: var(--basalt-muted);
  }
  .text a {
    font-weight: 600;
  }
  @media (min-width: 900px) {
    .layers {
      grid-template-columns: 5fr 7fr;
      align-items: center;
    }
    .write {
      grid-template-columns: 6fr 5fr;
    }
    .write .text {
      grid-column: 1 / -1;
    }
  }

  .strata {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .strata li {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 1rem 1.25rem;
    border-radius: 2px;
  }
  .strata strong {
    font: 800 1.25rem/1.2 var(--font-display);
    font-stretch: 115%;
  }
  .strata span {
    font-size: 0.9375rem;
  }
  .strata .s3 {
    margin-inline: 14%;
    background: var(--accent-soft);
  }
  .strata .s2 {
    margin-inline: 7%;
    background: var(--stone-sunk);
  }
  /* The foundations are the hero's own ground: the layer everything stands on. */
  .strata .s1 {
    background: var(--pine);
    color: #f5fff7;
  }

  .code {
    align-self: start;
    margin: 0;
    padding: 1.25rem 1.5rem;
    overflow-x: auto;
    background: var(--stone-sunk);
    border-radius: 3px;
    font: 400 0.875rem/1.65 var(--font-mono);
  }
  .code .c {
    color: var(--basalt-muted);
    font-style: italic;
  }
  .code .s {
    color: var(--ochre);
  }
  .code .k {
    color: var(--accent);
  }
  .reasons {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }
  .reasons li {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding-left: 1rem;
    border-left: 3px solid var(--basalt);
  }
  .reasons strong {
    font: 700 1.0625rem/1.3 var(--font-display);
    font-stretch: 112%;
  }
  .reasons span {
    color: var(--basalt-muted);
    font-size: 0.9375rem;
  }

  .clouds ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  }
  .clouds a {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
