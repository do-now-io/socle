# One file per cluster. Copy to prod.tfvars and edit; apply with
#   tofu init && tofu apply -var-file=prod.tfvars

# The only line an upgrade touches.
socle_version = "0.1.0" # x-release-please-version

# Only when Flux pulls the artifact from a private mirror: the pull secret
# created outside OpenTofu (docs/guides/private-registry.md).
# artifact_pull_secret = "ghcr-auth"

aws = {
  region             = "eu-west-3"
  cluster_name       = "acme-prod"
  owner              = "platform"
  environment        = "prod"
  # Kubernetes minor to run; the foundations module has no default for it.
  kubernetes_version = "1.34"
  availability_zones = ["eu-west-3a", "eu-west-3b", "eu-west-3c"]

  # No good default exists for who may reach the API endpoint.
  cluster_endpoint_public_access_cidrs = ["203.0.113.0/24"]

  # The bootstrap node group carries the socle itself, not your workloads:
  # two 4 vCPU nodes on Spot by default, over six Graviton families, about
  # $84 a month in eu-west-3. ON_DEMAND takes the first type, about $223.
  # bootstrap_node_capacity_type  = "ON_DEMAND"
  # bootstrap_node_instance_types = ["t4g.xlarge", "m7g.xlarge", "m6g.xlarge", "c7g.xlarge", "c6g.xlarge", "r6g.xlarge"]
  # bootstrap_node_count          = 2
  # Control plane logs are off by default: CloudWatch bills them by the
  # gigabyte. Turn on the API server's record of who did what when your
  # audit (ISO 27001, SOC 2) asks for it.
  # cluster_log_types = ["audit", "authenticator"]
  # Crossplane's own AWS identity, the one the socle cannot create for itself.
  # allowed_services is the ceiling of every role a catalog module gets:
  # add a service when you enable a module that uses it (route53 for
  # external_dns, sqs for keda, secretsmanager for external_secrets). Empty
  # grants nothing.
  # crossplane = { allowed_services = ["route53", "sqs", "secretsmanager"] }

  # The ACM certificate of the two shared Gateways, public (internet-facing)
  # and private (internal): acme.example and *.acme.example, validated in
  # the public Route 53 zone of that name, found for you. zone names the
  # parent zone when the domain is a subdomain of it. TLS terminates at their
  # load balancers; without it no Gateway is created, and ArgoCD gets no route.
  # gateway_certificate = { domain = "acme.example" }
  # gateway_certificate = { domain = "sbx.acme.example", zone = "acme.example" }
  # With it, kube.crossplane on and route53 in crossplane.allowed_services,
  # external_dns turns on by itself, filtered to that domain.
}

# Only what differs from the catalog's defaults. An unknown module or
# attribute is refused at plan, with the allowed list in the message.
kube = {
  # How catalog modules get their cloud access (docs/catalog/crossplane.md).
  # Off until a module needs it; with aws.crossplane set above, the root wires
  # the permissions boundary for you. Before turning it off again, delete the
  # modules' claims.
  # crossplane = { enabled = true }
  argocd = {
    domain = "argocd.acme.example"
    # Your ArgoCD, your values: merged over the socle's defaults, yours win.
    values = {
      configs = {
        cm   = { "accounts.alice" = "apiKey, login" }
        rbac = { "policy.csv" = "g, alice, role:admin" }
        repositories = {
          # The GitHub App's private key is NOT here: a Secret in the argocd
          # namespace named below carries it, or a repo-creds Secret of ArgoCD's own.
          acme = { url = "https://github.com/acme", type = "git", githubAppID = "12345", githubAppInstallationID = "67890" }
        }
      }
    }
    values_secret = "argocd-values"
  }
  # Metrics storage, on by default: 15 days on a 20Gi claim of the cluster's
  # default StorageClass. The bootstrap installs the EBS CSI driver but marks
  # no StorageClass default (docs/clouds/aws/limits.md), so the claim would
  # stay Pending: an empty storage_size keeps the data in an emptyDir, lost
  # when the pod moves.
  victoria_metrics = {
    storage_size = ""
    # retention  = "30d"
    # Flag values as strings: Helm renders a number from a million up as 1e+06.
    # values     = { server = { extraArgs = { "storage.maxHourlySeries" = "300000" } } }
  }
  # Logs storage, on by default: 7 days on a 20Gi claim — the same StorageClass
  # question as victoria_metrics above.
  victoria_logs = {
    storage_size = ""
  }
  # Traces are off by default (VictoriaTraces is pre-GA; an upgrade may drop
  # stored traces). Turning them on:
  # victoria_traces = { enabled = true, storage_size = "" }
  # The admission layer is off by default. The engine and the socle's policy
  # set, every policy reporting (Audit); enforce turns a policy into a refusal
  # the API server applies itself (docs/catalog/kyverno-policies.md):
  # kyverno          = { enabled = true }
  # kyverno_policies = {
  #   enabled            = true
  #   enforce            = ["disallow-privileged-containers"]
  #   allowed_registries = ["ghcr.io", "registry.k8s.io", "public.ecr.aws"]
  # }
  # Secrets from AWS Secrets Manager: with kube.crossplane on, the module's own
  # read-only role reads secret:<prefix>/* (default prefix: the cluster name)
  # and the ClusterSecretStore secret-manager serves it to every namespace
  # (docs/catalog/external-secrets.md). reloader rolls the workloads annotated
  # reloader.stakater.com/auto when those Secrets rotate.
  # external_secrets = { enabled = true }
  # reloader         = { enabled = true }
  hello = {
    replicas = 2
  }
  # Event-driven autoscaling. services names the AWS services KEDA's own role
  # may read, one read-only statement each (docs/catalog/keda.md); every one
  # must also be in aws.crossplane.allowed_services above. Leave it out for
  # cron, Prometheus, Kafka, RabbitMQ or Redis triggers: no cloud role needed.
  # keda = { enabled = true, services = ["sqs"] }
}

# Cilium is installed before Flux with these defaults; list only what
# differs. hubble adds Hubble Relay and UI; gateway_api = false stops Cilium
# serving the Gateway API (the CRDs stay). values takes any Cilium chart
# value and wins over the socle's; a private key is refused there — name a
# Secret you created in kube-system instead (existingSecret).
# cilium = {
#   hubble = true
#   values = { bandwidthManager = { enabled = true } }
# }
#
# The same for the CoreDNS installed with it:
# coredns = {
#   values = { replicaCount = 3 }
# }
#
# The EKS-managed add-ons installed once the nodes run. The Pod Identity
# Agent and EBS CSI are on by default; EFS CSI, for RWX volumes, is not.
# eks_addons = {
#   efs_csi = true
# }
