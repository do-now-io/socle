{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "version-file": "VERSION",
  "include-v-in-tag": false,
  "include-component-in-tag": false,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": false,
  "initial-version": "0.1.0",
  "changelog-path": "CHANGELOG.md",
  "pull-request-title-pattern": "chore(release): ${version}",
  "pull-request-header": "Merging this pull request releases the socle. Nothing is rebuilt: the alpha this merge publishes gets the version below as a second tag.",
  "extra-files": [
    { "type": "generic", "path": "opentofu/aws/main.tf" },
    { "type": "generic", "path": "opentofu/gcp/main.tf" },
    { "type": "generic", "path": "opentofu/azure/main.tf" },
    { "type": "generic", "path": "opentofu/scaleway/main.tf" },
    { "type": "generic", "path": "opentofu/bootstrap/main.tf" },
    { "type": "generic", "path": "opentofu/bootstrap/manifests/Chart.yaml" },
    { "type": "generic", "path": "opentofu/bootstrap/tests/defaults.tftest.hcl" },
    { "type": "generic", "path": "opentofu/aws/tests/defaults.tftest.hcl" },
    { "type": "generic", "path": "opentofu/azure/tests/defaults.tftest.hcl" },
    { "type": "generic", "path": "opentofu/clusters/aws/prod.tfvars.example" },
    { "type": "generic", "path": "oci/.ci/inputs-sample.yaml" }
  ],
  "packages": {
    ".": {}
  }
}
