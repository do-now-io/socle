{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":dependencyDashboard"
  ],
  "dependencyDashboardApproval": true,
  "timezone": "Europe/Paris",
  "schedule": ["before 6am on monday"],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "One weekly PR for all GitHub Actions bumps",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    },
    {
      "description": "One weekly PR for OpenTofu provider bumps",
      "matchManagers": ["terraform"],
      "groupName": "opentofu-providers"
    },
    {
      "description": "One weekly PR for the documentation site (Astro, Starlight and their plugins)",
      "matchManagers": ["npm"],
      "matchFileNames": ["site/package.json"],
      "groupName": "docs-site"
    },
    {
      "description": "Automerge patch, pin and digest updates once required checks pass",
      "matchUpdateTypes": ["patch", "pin", "pinDigest", "digest"],
      "automerge": true
    }
  ]
}
